{
  "name": "mesheditor",
  "version": "1.7.1",
  "description": "A free, open-source 3D modeling studio powered by Babylon.js. Create, edit, sculpt, retopologize and optimize 3D assets with optional AI assistance. Available on desktop, web & touch devices (iPad/iPhone/Android), Electron app and embeddable Web Component. Supports GLB, GLTF, OBJ, STL and PLY.",
  "private": false,
  "main": "dist-lib/index.umd.js",
  "module": "dist-lib/esm/index.js",
  "types": "dist-lib/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/esm/index.d.ts",
      "import": "./dist-lib/esm/index.js",
      "require": "./dist-lib/index.umd.js",
      "default": "./dist-lib/esm/index.js"
    },
    "./standalone": "./dist-lib/standalone/mesheditor-element.bundle.js",
    "./style.css": "./dist-lib/mesheditor.css",
    "./mesheditor.css": "./dist-lib/mesheditor.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/peer2p/mesheditor.git"
  },
  "homepage": "https://peer2p.github.io/mesheditor/",
  "bugs": {
    "url": "https://github.com/peer2p/mesheditor/issues"
  },
  "files": [
    "dist-lib/esm",
    "dist-lib/index.umd.js",
    "dist-lib/mesheditor.css",
    "dist-lib/mesheditor.css.map",
    "dist-lib/standalone/mesheditor-element.bundle.js",
    "src/mesheditor.css",
    "skills",
    "README.md"
  ],
  "scripts": {
    "dev": "webpack serve --mode development",
    "ai:bridge": "node scripts/antigravity-bridge.js",
    "ai:cli-bridge": "node scripts/local-cli-bridge.js",
    "build": "webpack --mode production",
    "build:pages": "npm run build:lib:bundle && npm run build && node scripts/prepare-pages.js",
    "build:itch": "npm run build && node scripts/prepare-itch.js",
    "build:dev": "webpack --mode development",
    "prod": "webpack serve --mode production --port 8080",
    "sync:skills": "node scripts/sync-skills.js",
    "sync:templates": "node scripts/sync-templates.js",
    "build:lib:styles": "node scripts/sync-styles.js",
    "build:lib:skills": "node scripts/sync-skills.js",
    "build:lib:templates": "node scripts/sync-templates.js",
    "build:lib:esm": "rm -rf dist-lib/esm && tsc -p tsconfig.lib.json",
    "build:lib:bundle": "webpack --config webpack.lib.config.js",
    "build:lib": "npm run build:lib:styles && npm run build:lib:skills && npm run build:lib:templates && npm run build:lib:esm && npm run build:lib:bundle",
    "icons:generate": "node scripts/generate-icons.js",
    "desktop:dev": "electron electron/main.js --dev",
    "desktop:start": "npm run build && electron electron/main.js",
    "desktop:build:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "desktop:build:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "desktop:build:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "desktop:build:all": "npm run build && electron-builder -mwl --config electron-builder.yml",
    "test": "vitest run",
    "test:integration": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist dist-lib dist-itch release",
    "prepublishOnly": "npm run build:lib"
  },
  "keywords": [
    "babylonjs",
    "mesh-editor",
    "web-component",
    "custom-element",
    "3d",
    "webgl",
    "typescript",
    "electron",
    "touch",
    "mobile",
    "tablet"
  ],
  "author": "daniel.peer@gmx.net",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@babylonjs/core": ">=9.29.0",
    "@babylonjs/loaders": ">=9.29.0",
    "@babylonjs/materials": ">=9.29.0",
    "@babylonjs/serializers": ">=9.29.0"
  },
  "dependencies": {
    "@babylonjs/core": ">=9.29.0",
    "@babylonjs/loaders": ">=9.29.0",
    "@babylonjs/materials": ">=9.29.0",
    "@babylonjs/serializers": ">=9.29.0",
    "dat.gui": "^0.7.9",
    "earcut": "2.2.4",
    "lucide": "^1.76.0",
    "marked": "^18.1.2",
    "three": "^0.187.0",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/dat.gui": "^0.7.13",
    "@types/node": "^26.2.0",
    "@types/three": "^0.187.0",
    "copy-webpack-plugin": "^13.0.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "html-webpack-plugin": "^5.6.4",
    "jsdom": "^30.1.3",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  }
}
