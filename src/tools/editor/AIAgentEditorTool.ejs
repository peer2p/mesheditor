<div id="dialog-ai-agent" class="floating-dialog" style="top: 64px; left: 660px; width: 380px; z-index: 58">
          <div class="dialog-header">
            <span class="dialog-title" id="aiDialogTitle"><i class="app-icon" data-lucide="bot" id="aiDialogTitleIcon"></i> <span id="aiDialogTitleText">AI Mesh Agent</span></span>
            <div class="dialog-actions">
              <button class="dialog-btn" id="btnAISettingsToggle" title="Configure OpenAI-Compatible Endpoint & Skills">
                <i class="app-icon" data-lucide="settings"></i>
              </button>
              <button class="dialog-btn btn-help" title="Help & Tool Guide" aria-label="Help"><i class="app-icon" data-lucide="help-circle"></i></button>
            <button class="dialog-btn btn-min" title="Minimize"><i class="app-icon" data-lucide="minus"></i></button>
              <button class="dialog-btn btn-close" title="Close"><i class="app-icon" data-lucide="x"></i></button>
            </div>
          </div>

          <!-- Endpoint & Skills Configuration Drawer -->
          <div id="aiSettingsPanel" class="ai-settings-panel" style="display: none">
            <div class="ai-settings-title-row">
              <span class="ai-settings-title">OpenAI-Compatible Endpoint</span>
              <div class="ai-preset-chips" id="aiPresetChips">
                <button type="button" class="ai-chip-btn" data-preset="antigravity">Antigravity</button>
                <button type="button" class="ai-chip-btn" data-preset="gemini">Gemini Flash</button>
                <button type="button" class="ai-chip-btn" data-preset="gemini-pro">Gemini Pro</button>
                <button type="button" class="ai-chip-btn" data-preset="openai">OpenAI</button>
                <button type="button" class="ai-chip-btn" data-preset="openrouter">OpenRouter</button>
                <button type="button" class="ai-chip-btn" data-preset="ollama">Ollama</button>
                <button type="button" class="ai-chip-btn" data-preset="lmstudio">LM Studio</button>
              </div>
            </div>

            <div class="ai-form-group">
              <label for="aiEndpointUrlInput">Base URL</label>
              <input
                type="text"
                id="aiEndpointUrlInput"
                class="ai-input"
                placeholder="https://api.openai.com/v1"
                autocomplete="off"
              />
            </div>

            <div class="ai-form-group">
              <label for="aiApiKeyInput">API Key</label>
              <div class="ai-input-row">
                <input
                  type="password"
                  id="aiApiKeyInput"
                  class="ai-input"
                  placeholder="sk-... (optional for local Ollama / LM Studio)"
                  autocomplete="off"
                />
                <button type="button" class="ai-icon-btn" id="btnToggleApiKeyVis" title="Show/Hide API Key">
                  <i class="app-icon" data-lucide="eye"></i>
                </button>
              </div>
            </div>

            <div class="ai-form-group">
              <div class="ai-slider-header" style="margin-bottom: 4px;">
                <label for="aiModelSelect">Model</label>
                <button type="button" class="ai-link-btn" id="btnToggleCustomModel" style="font-size: 10px; color: var(--accent-hover);">Custom ID...</button>
              </div>
              <div class="ai-input-row">
                <select id="aiModelSelect" class="ai-select tool-select" style="flex: 1; min-width: 0;">
                  <option value="gemini-3.8-flash-medium">gemini-3.8-flash-medium</option>
                  <option value="gemini-3.8-flash-high">gemini-3.8-flash-high</option>
                  <option value="gemini-3.8-flash-low">gemini-3.8-flash-low</option>
                  <option value="gemini-4-argon-medium">gemini-4-argon-medium</option>
                  <option value="gemini-4-argon-high">gemini-4-argon-high</option>
                  <option value="gemini-4-argon-low">gemini-4-argon-low</option>
                  <option value="claude-sonnet-5-5-medium">claude-sonnet-5-5-medium</option>
                  <option value="claude-sonnet-5-5-high">claude-sonnet-5-5-high</option>
                  <option value="claude-sonnet-5-5-low">claude-sonnet-5-5-low</option>
                  <option value="claude-opus-5-5-medium">claude-opus-5-5-medium</option>
                  <option value="claude-opus-5-5-high">claude-opus-5-5-high</option>
                  <option value="claude-opus-5-5-low">claude-opus-5-5-low</option>
                  <option value="gpt-oss-120b-medium">gpt-oss-120b-medium</option>
                  <option value="gpt-4o">gpt-4o</option>
                  <option value="gemini-3-flash-preview">gemini-3-flash-preview</option>
                  <option value="gemini-3.1-pro-preview">gemini-3.1-pro-preview</option>
                  <option value="qwen2.5-coder:14b">qwen2.5-coder:14b</option>
                </select>
                <input
                  type="text"
                  id="aiModelInput"
                  class="ai-input"
                  placeholder="gpt-4o"
                  autocomplete="off"
                  style="display: none; flex: 1; min-width: 0;"
                />
                <button type="button" class="ai-icon-btn" id="btnFetchAIModels" title="Load available models from endpoint (/models)">
                  <i class="app-icon" data-lucide="refresh-cw"></i>
                </button>
              </div>
            </div>

            <div class="ai-form-group">
              <label>Built-in Agent Skills</label>
              <div id="aiSkillsList" class="ai-skills-list"></div>
            </div>

            <!-- Mesh Generation Constraints -->
            <div class="ai-settings-title-row" style="margin-top: 6px; padding-top: 6px; border-top: 1px solid rgba(255, 255, 255, 0.08);">
              <span class="ai-settings-title">Mesh Generation & Asset Budget</span>
            </div>

            <div class="ai-form-group">
              <div class="ai-slider-header">
                <label for="aiMinPolyInput">Minimum Polygons</label>
                <span class="ai-slider-value" id="aiMinPolyVal">200</span>
              </div>
              <input
                type="range"
                id="aiMinPolyInput"
                class="ai-slider"
                min="50"
                max="5000"
                step="50"
                value="200"
              />
              <div class="ai-slider-subtext">Ensures sufficient geometric definition for game models.</div>
            </div>

            <div class="ai-form-group">
              <div class="ai-slider-header">
                <label for="aiMaxPolyInput">Maximum Polygons</label>
                <span class="ai-slider-value" id="aiMaxPolyVal">5,000</span>
              </div>
              <input
                type="range"
                id="aiMaxPolyInput"
                class="ai-slider"
                min="500"
                max="1000000"
                step="500"
                value="5000"
              />
              <div class="ai-preset-chips" id="aiMaxPolyChips" style="margin-top: 5px;">
                <button type="button" class="ai-chip-btn" data-poly="2500">2.5k</button>
                <button type="button" class="ai-chip-btn" data-poly="5000">5k (Default)</button>
                <button type="button" class="ai-chip-btn" data-poly="25000">25k</button>
                <button type="button" class="ai-chip-btn" data-poly="100000">100k</button>
                <button type="button" class="ai-chip-btn" data-poly="500000">500k</button>
                <button type="button" class="ai-chip-btn" data-poly="1000000">1M</button>
              </div>
              <div class="ai-slider-subtext" style="margin-top: 4px;">Target geometric complexity ceiling (500 to 1,000,000 polygons).</div>
            </div>

            <div class="ai-form-group">
              <label class="ai-checkbox-label" for="aiCreateTexturesCheck" style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                <input type="checkbox" id="aiCreateTexturesCheck" checked />
                <span><strong>Create Textures</strong></span>
              </label>
              <div class="ai-slider-subtext">AI creates PBR textures when checked, otherwise solid PBR colors are used.</div>
            </div>

            <div class="ai-form-group">
              <label class="ai-checkbox-label" for="aiCreateNormalMapsCheck" style="cursor: pointer; display: flex; align-items: center; gap: 8px;">
                <input type="checkbox" id="aiCreateNormalMapsCheck" checked />
                <span><strong>Create Normal Maps</strong></span>
              </label>
              <div class="ai-slider-subtext">AI generates normal/bump maps for surface depth and relief when checked.</div>
            </div>

            <div class="ai-settings-actions" style="display: flex; gap: 8px;">
              <button type="button" class="tool-btn" id="btnCancelAISettings" style="flex: 1;">
                <span class="btn-icon"><i class="app-icon" data-lucide="arrow-left"></i></span>
                <span class="btn-label">Back</span>
              </button>
              <button type="button" class="tool-btn btn-primary" id="btnSaveAISettings" style="flex: 1.5;">
                <span class="btn-icon"><i class="app-icon" data-lucide="check"></i></span>
                <span class="btn-label">Save Settings</span>
              </button>
            </div>
          </div>

          <div class="dialog-body ai-agent-body" id="aiAgentBody">
            <!-- Status & Mode Bar -->
            <div class="ai-mode-bar">
              <select id="aiActionModeSelect" class="ai-select tool-select" title="Choose how generated meshes interact with current scene">
                <option value="create_or_update">Create / Update in Scene</option>
                <option value="replace_scene">Replace Scene (Clear First)</option>
              </select>
              <label class="ai-checkbox-label" title="Generate procedural and seamless textures on created meshes">
                <input type="checkbox" id="aiCreateTexturesCheckQuick" checked />
                <span>Textures</span>
              </label>
              <label class="ai-checkbox-label" title="Generate normal/bump maps for surface micro-relief and depth">
                <input type="checkbox" id="aiCreateNormalMapsCheckQuick" checked />
                <span>Normal Maps</span>
              </label>
              <label class="ai-checkbox-label" title="Send a screenshot of the current 3D viewport to the vision model">
                <input type="checkbox" id="aiIncludeViewportCheck" />
                <span>+ 3D View</span>
              </label>
            </div>

            <div class="ai-endpoint-summary" id="aiEndpointSummaryBar">
              <span class="ai-endpoint-dot" id="aiEndpointStatusDot"></span>
              <span id="aiEndpointSummaryText">Model: gpt-4o</span>
              <button type="button" class="ai-link-btn" id="btnOpenAISettingsInline">Configure</button>
            </div>

            <!-- Quick Example Prompts -->
            <div class="ai-quick-prompts" id="aiQuickPrompts">
              <button type="button" class="ai-prompt-chip" data-prompt="Build an ancient fluted stone pillar with a stepped base and capital.">Stone Pillar</button>
              <button type="button" class="ai-prompt-chip" data-prompt="Create a metallic gear wheel with 12 teeth and a center bore.">Gear Wheel</button>
              <button type="button" class="ai-prompt-chip" data-prompt="Build a medieval wooden treasure chest with golden trim.">Treasure Chest</button>
              <button type="button" class="ai-prompt-chip" data-prompt="Build a detailed voxel knight helmet with visor.">Voxel Helmet</button>
              <button type="button" class="ai-prompt-chip" data-prompt="Update the currently selected mesh: hollow it out with CSG and apply a polished marble material.">Mesh Update</button>
              <button type="button" class="ai-prompt-chip" data-prompt="Build a Super Mario 3D Mesh in swimming trunks in T-Pose using Figure Sculptor with organic soft contours. Spawn the chibi base mesh in organic style, sculpt Mario features and retopologize to 15,000 triangles.">Mario in trunks</button>
            </div>

            <!-- Chat & Tool Execution Log -->
            <div id="aiChatLog" class="ai-chat-log"></div>

            <!-- Attached Images Preview Bar -->
            <div id="aiImageAttachmentsBar" class="ai-image-attachments" style="display: none"></div>

            <!-- Prompt Input & Controls -->
            <div class="ai-input-area">
              <textarea
                id="aiPromptInput"
                class="ai-prompt-textarea"
                rows="3"
                placeholder="Enter a prompt (e.g. 'Build a stone archway' or 'Add a roof to selected mesh')... Attach images via button, Drag & Drop or Cmd+V."
              ></textarea>
              <div class="ai-controls-row">
                <div class="ai-controls-left">
                  <button type="button" class="tool-btn" id="btnAIRecordSpeech" title="Voice: Record prompt using Speech-to-Text">
                    <span class="btn-icon"><i class="app-icon" data-lucide="mic"></i></span>
                  </button>
                  <button type="button" class="tool-btn" id="btnAIAttachImage" title="Attach Image: Reference image for Image-to-Mesh">
                    <span class="btn-icon"><i class="app-icon" data-lucide="image"></i></span>
                  </button>
                  <button type="button" class="tool-btn" id="btnAICaptureView" title="Capture View: Attach screenshot of current 3D viewport">
                    <span class="btn-icon"><i class="app-icon" data-lucide="camera"></i></span>
                  </button>
                  <button type="button" class="tool-btn" id="btnAIClearChat" title="Clear Chat: Reset AI conversation history">
                    <span class="btn-icon"><i class="app-icon" data-lucide="trash-2"></i></span>
                  </button>
                </div>
                <div class="ai-controls-right">
                  <button type="button" class="tool-btn btn-danger" id="btnAIStop" style="display: none" title="Stop: Cancel running AI generation">
                    <span class="btn-icon"><i class="app-icon" data-lucide="square"></i></span>
                  </button>
                  <button type="button" class="tool-btn btn-primary" id="btnAIGenerate" title="Generate: Run AI Mesh Agent (Enter / Cmd+Enter)">
                    <span class="btn-icon"><i class="app-icon" data-lucide="send"></i></span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
