<div id="dialog-uv-unwrap" class="floating-dialog" style="top: 150px; right: 365px; width: 340px; display: none">
  <div class="dialog-header">
    <span class="dialog-title"><i class="app-icon" data-lucide="map"></i> UV Unwrap &amp; Texel Density</span>
    <div class="dialog-actions">
      <button class="dialog-btn btn-help" title="Help &amp; Tool Guide" aria-label="Help"><i class="app-icon" data-lucide="help-circle"></i></button>
      <button class="dialog-btn btn-min" title="Minimize"><i class="app-icon" data-lucide="minus"></i></button>
      <button class="dialog-btn btn-close" title="Close"><i class="app-icon" data-lucide="x"></i></button>
    </div>
  </div>
  <div class="dialog-body sculpt-tool-body">
    <!-- 1. Smart Seam Marking -->
    <div class="tool-control-group">
      <div class="sculpt-section-title"><i class="app-icon" data-lucide="scissors"></i> Smart Seam Marking</div>
      <div class="sculpt-slider-row">
        <div class="sculpt-slider-header">
          <span class="sculpt-slider-label">Seam Angle Threshold</span>
          <span id="uvSeamAngleVal" class="sculpt-slider-val">60°</span>
        </div>
        <input type="range" id="sliderUVSeamAngle" min="20" max="89" step="1" value="60" class="tool-range" />
      </div>

      <div class="sculpt-grid-2" style="margin-top: 6px;">
        <button type="button" id="btnUVMarkSmartSeams" class="sculpt-btn" title="Automatically detect and mark UV seams along sharp edges and cylindrical loops">
          <i class="app-icon" data-lucide="wand-2"></i> Auto Seams
        </button>
        <button type="button" id="btnUVClearSeams" class="sculpt-btn" title="Clear all marked UV seams on the active mesh">
          <i class="app-icon" data-lucide="trash-2"></i> Clear Seams
        </button>
      </div>

      <div class="sculpt-options-row" style="margin-top: 6px;">
        <label class="sculpt-checkbox-label" title="Click edges directly on the 3D model in the viewport to toggle UV cut seams">
          <input type="checkbox" id="chkUVInteractiveSeamPick" />
          <span><strong>Click 3D Edges to Mark Seams</strong></span>
        </label>
      </div>
    </div>

    <!-- 2. Unwrap & Island Packing -->
    <div class="tool-control-group" style="border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 10px;">
      <div class="sculpt-section-title"><i class="app-icon" data-lucide="layout-grid"></i> Unwrap &amp; Island Packing</div>
      <div class="tool-row" style="margin-top: 4px;">
        <span class="tool-label">Method</span>
        <select id="selectUVUnwrapMethod" class="tool-select" style="flex: 1;">
          <option value="smart_seams" selected>Smart Seams + LSCM Relax</option>
          <option value="angle_project">Angle-Based Projection</option>
          <option value="cylindrical">Cylindrical Character Wrap</option>
        </select>
      </div>

      <div class="tool-row" style="margin-top: 4px;">
        <span class="tool-label">Island Padding</span>
        <select id="selectUVIslandMargin" class="tool-select" style="flex: 1;">
          <option value="2">2 px (Tight)</option>
          <option value="6" selected>6 px (Standard Mipmap Safe)</option>
          <option value="12">12 px (Wide Margin)</option>
          <option value="16">16 px (Bake Safe)</option>
        </select>
      </div>

      <div class="sculpt-options-row" style="margin-top: 6px;">
        <label class="sculpt-checkbox-label">
          <input type="checkbox" id="chkUVRotateOptimal" checked />
          <span>90° Optimal Island Rotation</span>
        </label>
        <label class="sculpt-checkbox-label">
          <input type="checkbox" id="chkUVCheckerPreview" />
          <span>UV Checker</span>
        </label>
      </div>

      <div class="sculpt-grid-2" style="margin-top: 6px;">
        <button type="button" id="btnExecuteUVUnwrap" class="tool-btn tool-btn-primary" title="Unwrap mesh along seams and pack UV islands">
          <i class="app-icon" data-lucide="map"></i> Unwrap Mesh
        </button>
        <button type="button" id="btnPackUVIslands" class="tool-btn" title="Re-pack existing UV islands to maximize UV space without overlap">
          <i class="app-icon" data-lucide="package"></i> Pack Islands
        </button>
      </div>
    </div>

    <!-- 3. Texel Density Tools -->
    <div class="tool-control-group" style="border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 10px;">
      <div class="sculpt-section-title"><i class="app-icon" data-lucide="maximize-2"></i> Texel Density (px/m)</div>
      <div class="tool-row" style="margin-top: 4px;">
        <span class="tool-label">Map Size</span>
        <select id="selectUVTextureRes" class="tool-select" style="flex: 1;">
          <option value="512">512 × 512</option>
          <option value="1024" selected>1024 × 1024 (1K)</option>
          <option value="2048">2048 × 2048 (2K)</option>
          <option value="4096">4096 × 4096 (4K)</option>
        </select>
      </div>

      <div class="tool-row" style="margin-top: 4px;">
        <span class="tool-label">Target px/m</span>
        <input type="number" id="numUVTargetTexelDensity" class="tool-input" min="64" max="4096" step="64" value="512" style="flex: 1;" />
        <button type="button" id="btnApplyTexelDensity" class="tool-btn" style="padding: 4px 10px;" title="Normalize all UV islands to the exact target Texel Density (px/m)">
          Equalize
        </button>
      </div>
    </div>

    <!-- 4. Live 2D UV Layout Preview & Metrics -->
    <div class="tool-control-group" style="border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 8px;">
      <div class="sculpt-slider-header" style="margin-bottom: 4px;">
        <span class="sculpt-slider-label">2D UV Layout [0, 1]</span>
        <span id="uvCoverageBadge" style="font-size: 10px; color: #38bdf8; font-family: monospace;">Coverage: 0%</span>
      </div>
      <div style="display: flex; justify-content: center; background: #0d1117; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 6px; padding: 4px;">
        <canvas id="uvPreviewCanvas" width="220" height="220" style="width: 220px; height: 220px; border-radius: 4px;"></canvas>
      </div>
    </div>

    <div class="sculpt-stats-card">
      <div class="sculpt-stats-row">
        <span style="color: #8b949e;">UV Islands / Seams:</span>
        <span id="uvStatIslandsSeams" style="color: #f0f6fc; font-family: monospace;">0 islands / 0 seams</span>
      </div>
      <div class="sculpt-stats-row">
        <span style="color: #8b949e;">Texel Density:</span>
        <span id="uvStatTexelDensity" style="color: #3fb950; font-weight: 600; font-family: monospace;">0 px/m</span>
      </div>
      <div class="sculpt-stats-row">
        <span style="color: #8b949e;">3D Surface Area:</span>
        <span id="uvStatSurfaceArea" style="color: #f0f6fc; font-family: monospace;">0.00 m²</span>
      </div>
    </div>
  </div>
</div>
